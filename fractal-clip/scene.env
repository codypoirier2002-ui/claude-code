# Scene parameters for bulb.cpp (sourced by render.sh)
export AZ0=-15 EL0=14 R0=5.0      # opening camera: azimuth, elevation (deg), distance
export LAZ=-70 LEL=35             # key light direction
export SX=0 SY=-0.05            # dive target, screen position in the opening shot
export S1=0.004                   # final camera distance to the surface (~800x zoom)
export TILT=0.35 SWING=45         # final viewing angle relative to the surface
export FOV0=34 FOV1=50
